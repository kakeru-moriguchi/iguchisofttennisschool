# =============================================================
# イグチソフトテニススクール ホームページ 環境変数
#
# このファイルをコピーして「.env.local」を作成し、値を設定してください。
#   cp .env.example .env.local
#
# ※ .env.local は Git に登録されません（.gitignore 済み）
# ※ ここに書いた値はサーバー側でのみ使用され、
#    ブラウザに送られるコードには一切含まれません。
# =============================================================

# -------------------------------------------------------------
# 【必須】お問い合わせの受信先メールアドレス
# -------------------------------------------------------------
CONTACT_TO_EMAIL=iguchi0307@gmail.com


# -------------------------------------------------------------
# 送信方法：以下のどちらか一方を設定してください
# -------------------------------------------------------------

# ▼ 方法1：Resend を使う（推奨・Vercel へのデプロイ向き）
#
#   1. https://resend.com に登録し、API キーを発行
#   2. RESEND_API_KEY に貼り付け
#   3. 独自ドメインを認証した場合は CONTACT_FROM_EMAIL をそのドメインに変更
#      （未設定の場合はテスト用の onboarding@resend.dev が使われます）
#
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_FROM_EMAIL=noreply@あなたのドメイン


# ▼ 方法2：SMTP を使う（Gmail など）
#
#   Gmail の場合：
#   1. Google アカウントで「2段階認証」を有効にする
#   2. https://myaccount.google.com/apppasswords で「アプリパスワード」を発行
#   3. SMTP_PASS にそのアプリパスワード（16桁）を設定
#      ※ 通常のログインパスワードでは送信できません
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=iguchi0307@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# CONTACT_FROM_EMAIL=iguchi0307@gmail.com
